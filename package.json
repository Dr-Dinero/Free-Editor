{
  "name": "free-editor",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Free AI video editor for Claude Code and Codex: talking-head Reels and Shorts, long-form edits, and motion graphics with measured craft QC. Built on Nate Herk's Herk Edit Kit.",
  "scripts": {
    "transcribe": "node scripts/transcribe-elevenlabs.mjs",
    "validate-beats": "node scripts/validate-beat-sync.mjs",
    "preflight": "node scripts/preflight.mjs",
    "sync:skills": "node scripts/sync-codex-skills.mjs",
    "check:skills": "node scripts/sync-codex-skills.mjs --check",
    "setup": "node scripts/setup.mjs",
    "new-video": "node scripts/new-video.mjs",
    "demo": "node scripts/new-video.mjs demo",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-kit.mjs",
    "catalog": "node scripts/style-library/build-registry.mjs",
    "test:media": "node scripts/smoke-media.mjs",
    "validate:short-form": "node .claude/skills/short-form-edit/scripts/validate-plan.mjs",
    "validate:footage": "node .claude/skills/short-form-edit/scripts/validate-footage.mjs",
    "preflight:all": "node scripts/preflight-all.mjs",
    "edit": "python3 .claude/skills/talking-head-edit/scripts/talking_head.py",
    "qc": "python3 .claude/skills/edit-qc/scripts/craft_qc.py",
    "gate": "python3 .claude/skills/edit-qc/scripts/first_pass_gate.py",
    "deliver": "python3 scripts/deliver.py",
    "tools": "python3 scripts/power_tools.py",
    "engine:sync": "node scripts/engine-sync.mjs",
    "engine:check": "node scripts/engine-sync.mjs --check",
    "lottie:vendor": "node scripts/vendor-lottie.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.7.109",
    "lottie-web": "5.13.0",
    "playwright": "^1.59.1"
  }
}
